{
  "name": "mexerp",
  "version": "1.0.0",
  "type": "module",
  "description": "MEXERP Discord Ticket System - Professional Bot",
  "main": "index.js",
  "scripts": {
    "start": "bash start.sh",
    "start:node": "node index.js",
    "start:bun": "bun run src/index.ts",
    "start:tsx": "tsx src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "deploy": "bun run src/deploy.ts",
    "deploy:node": "node dist/deploy.js"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/util": "^1.2.0",
    "@discordjs/ws": "^2.0.4",
    "@napi-rs/canvas": "^1.0.3",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "mammoth": "^1.12.1",
    "mongoose": "^8.5.0",
    "tsx": "^4.23.12",
    "unpdf": "^1.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
